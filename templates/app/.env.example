# Every environment variable this app reads. Copy to .env and set what you need.
#
# Each entry below says whether it is required. A required variable that is unset stops the boot with
# a message naming it, and so does an invalid value, so a misconfigured server never answers 200.
#
# Empty string counts as unset, the same rule for every hearthkit variable.

# Which environment the app thinks it is in. One of development, test, production.
# Optional, defaults to development. The container image sets production.
# NODE_ENV=production

# GlitchTip (Sentry-compatible) ingest URL for error reporting.
# Optional; unset means error reporting is a no-op.
# GLITCHTIP_DSN=https://abc123@glitchtip.example.com/1

# Minimum level written to stdout, one of trace, debug, info, warn, error, fatal.
# Optional, defaults to info.
# LOG_LEVEL=debug
# hearthkit-section:begin @hearthkit/storage

# Object storage, S3-compatible: MinIO locally, Cloudflare R2 in production.
# hearthkit dev infra up publishes MinIO on 9000 with hearthkit/hearthkit as the credential pair.

# Endpoint of the object store, http or https, with no path. Required.
# STORAGE_ENDPOINT=http://127.0.0.1:9000

# Bucket every object goes in; lowercase letters, digits and hyphens. Required.
# STORAGE_BUCKET=hearthkit-app

# Region the S3 API is told to sign for. Optional, defaults to auto, which is what R2 wants.
# STORAGE_REGION=auto

# Public half of the credential pair. Required.
# STORAGE_ACCESS_KEY_ID=hearthkit

# Private half of the credential pair. Required, and never write it to a log or a ticket.
# STORAGE_SECRET_ACCESS_KEY=hearthkit
# hearthkit-section:end @hearthkit/storage
# hearthkit-section:begin @hearthkit/email

# Transactional email. hearthkit dev infra up publishes Mailpit on 1025 for SMTP and 8025 for its
# web interface, which is what the smtp transport below points at.

# Which transport sends the mail, smtp or resend. Required.
# EMAIL_TRANSPORT=smtp

# Sender of every message, either an address or a display name and an address. Required.
# EMAIL_FROM=hearthkit app <no-reply@example.com>

# Host of the SMTP server. Required for the smtp transport.
# EMAIL_SMTP_HOST=127.0.0.1

# Port of the SMTP server; 465 means implicit TLS. Required for the smtp transport.
# EMAIL_SMTP_PORT=1025

# SMTP user name. Optional; Mailpit accepts anything, a real relay does not.
# EMAIL_SMTP_USER=hearthkit

# SMTP password. Optional for Mailpit, required by every real relay.
# EMAIL_SMTP_PASSWORD=hearthkit

# Resend API key. Required for the resend transport.
# EMAIL_RESEND_API_KEY=re_your_api_key

# Resend API base URL. Optional; override it only to point at a proxy or a stub.
# EMAIL_RESEND_BASE_URL=https://api.resend.com
# hearthkit-section:end @hearthkit/email
# hearthkit-section:begin @hearthkit/auth

# Accounts and sessions, over Postgres. hearthkit dev infra up publishes Postgres on 5432.
# The tables come from this app's own migration: run pnpm db:generate, then hearthkit db migrate.

# Postgres connection string this app reads and writes through. Required.
# DATABASE_URL=postgresql://hearthkit:hearthkit@127.0.0.1:5432/hearthkit

# Secret every session cookie and token is signed with. Required, and never share it between
# environments; generate one with `openssl rand -base64 32`.
# AUTH_SECRET=replace-me-with-a-long-random-value

# Absolute URL this app is reached at, which is what every emailed sign-in link is built from.
# Required.
# AUTH_BASE_URL=http://127.0.0.1:3000

# Google OAuth credentials. Optional, but both halves are needed or neither.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GitHub OAuth credentials. Optional, but both halves are needed or neither.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# hearthkit-section:end @hearthkit/auth
# hearthkit-section:begin @hearthkit/payments

# Stripe subscriptions and one-time purchases. Use a test-mode key; nothing here should ever meet a
# live account.

# Stripe secret API key. Required.
# STRIPE_SECRET_KEY=sk_test_your_test_mode_key

# Secret the webhook signature is verified against; `stripe listen` prints one, and a self-hosted
# delivery can use any value both sides agree on. Required.
# STRIPE_WEBHOOK_SECRET=whsec_your_signing_secret
# hearthkit-section:end @hearthkit/payments
