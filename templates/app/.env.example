# Every environment variable this app reads. Copy to .env and uncomment what you need.
# Each one is optional, so the app boots with this file empty; an invalid value fails the boot
# loudly with a message naming the variable.
#
# Empty string counts as unset, the same rule for every hearthkit variable.

# Which environment the app thinks it is in. One of development, test, production.
# Defaults to development. The container image sets production.
# NODE_ENV=production

# GlitchTip (Sentry-compatible) ingest URL for error reporting. Unset means no errors are sent.
# GLITCHTIP_DSN=https://abc123@glitchtip.example.com/1

# Minimum level written to stdout, one of trace, debug, info, warn, error, fatal. Defaults to info.
# LOG_LEVEL=debug
