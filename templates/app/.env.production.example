# Every environment variable this app reads in production, and where each value comes from.
#
# This file is an example, never the real thing: it holds no secret and it is committed. Paste the
# values into Dokploy's environment editor for the application; nothing here is read at run time.
#
# `hearthkit infra apply` rewrites the STORAGE_ lines below and the comment above GLITCHTIP_DSN=
# from the OpenTofu module's outputs, and leaves every other byte of this file alone. It never
# writes STORAGE_SECRET_ACCESS_KEY: that value is printed once on your terminal and pasted by hand.
#
# Empty string counts as unset, the same rule for every hearthkit variable.

# Which environment the app thinks it is in. The container image already sets production, so this
# only needs setting when you are overriding it.
# NODE_ENV=production

# Minimum level written to stdout, one of trace, debug, info, warn, error, fatal.
# Optional, defaults to info.
# LOG_LEVEL=info

# GlitchTip (Sentry-compatible) ingest URL for error reporting. Optional; unset means error
# reporting is a no-op.
#
# The one comment line directly above GLITCHTIP_DSN= is what `hearthkit infra apply` replaces with
# the module's own guidance, so keep this variable last in its block.
# Copy the project DSN from GlitchTip and paste it below.
GLITCHTIP_DSN=

# Object storage, S3-compatible: Cloudflare R2 in production, MinIO locally.
# hearthkit infra apply fills the four lines below from the module it applied. The secret stays
# blank here on purpose; copy it from the command's own output.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=

# Transactional email. Production uses the resend transport; the smtp settings are here for a
# self-hosted relay instead.
# EMAIL_TRANSPORT=resend
# EMAIL_FROM=your app <no-reply@your-domain>
# EMAIL_RESEND_API_KEY=
# EMAIL_RESEND_BASE_URL=https://api.resend.com
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=

# Accounts and sessions, over Postgres. The connection string is the one `hearthkit db create`
# printed once on the VPS; the secret is per environment and is never shared with development.
# DATABASE_URL=
# AUTH_SECRET=
# AUTH_BASE_URL=https://your-project.your-domain

# Google OAuth credentials. Optional, but both halves are needed or neither.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GitHub OAuth credentials. Optional, but both halves are needed or neither.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Stripe subscriptions and one-time purchases. A production deployment uses live-mode keys, which
# nothing in this repository's gates may ever see.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
