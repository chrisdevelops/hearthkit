{
  "name": "@hearthkit/cli",
  "version": "0.0.0",
  "description": "The hearthkit binary: db lifecycle, dev infra, and doctor commands over @hearthkit/db",
  "homepage": "https://github.com/chrisdevelops/hearthkit/tree/main/packages/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisdevelops/hearthkit.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "bin": {
    "hearthkit": "./src/hearthkit-bin-entry.js"
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "24.20.0"
  },
  "scripts": {
    "prepublishOnly": "node ../../scripts/assert-package-publishable.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hearthkit/config": "workspace:*",
    "@hearthkit/db": "workspace:*",
    "@hearthkit/payments": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
