{
  "name": "@hearthkit/storage",
  "version": "0.1.1",
  "description": "S3-compatible object storage with presigned uploads and downloads for MinIO and Cloudflare R2",
  "homepage": "https://github.com/chrisdevelops/hearthkit/tree/main/packages/storage",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisdevelops/hearthkit.git",
    "directory": "packages/storage"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "24.20.0"
  },
  "scripts": {
    "prepublishOnly": "node ../../scripts/assert-package-publishable.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1121.0",
    "@aws-sdk/s3-request-presigner": "3.1121.0",
    "@hearthkit/config": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
