{
  "name": "@hearthkit/config",
  "version": "0.1.0",
  "description": "One validated schema for all hearthkit environment variables, composed from per-package fragments",
  "homepage": "https://github.com/chrisdevelops/hearthkit/tree/main/packages/config",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisdevelops/hearthkit.git",
    "directory": "packages/config"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./register-node-modules-type-stripping": "./src/register-node-modules-type-stripping.js"
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "24.20.0"
  },
  "scripts": {
    "prepublishOnly": "node ../../scripts/assert-package-publishable.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
