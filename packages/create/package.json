{
  "name": "@hearthkit/create",
  "version": "0.0.0",
  "description": "Scaffolds a new project from the hearthkit app template: pnpm create @hearthkit",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "bin": {
    "create-hearthkit-project": "./src/create-bin-entry.js"
  },
  "files": [
    "src",
    "app-template"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "24.20.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:scaffold": "HEARTHKIT_SCAFFOLD_GATES=1 vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON copy-bundled-app-template.ts"
  },
  "dependencies": {
    "@hearthkit/cli": "workspace:*",
    "@hearthkit/config": "workspace:*",
    "@hearthkit/db": "workspace:*",
    "@hearthkit/observability": "workspace:*",
    "@hearthkit/ui": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
