{
  "name": "@hearthkit/payments",
  "version": "0.0.0",
  "description": "Stripe subscriptions and one-time purchases: catalog sync, hosted checkout, the hosted customer portal, and the webhook handler",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./payments-contract": {
      "types": "./src/payments-contract.ts",
      "default": "./src/payments-contract.ts"
    }
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "24.20.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hearthkit/auth": "workspace:*",
    "@hearthkit/config": "workspace:*",
    "@hearthkit/db": "workspace:*",
    "drizzle-orm": "0.45.2",
    "stripe": "22.6.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "pg": "8.23.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
