{
  "name": "@hearthkit/auth",
  "version": "0.5.0",
  "description": "Better Auth wired to the hearthkit Drizzle client and email transport, with magic link, password and organizations",
  "license": "MIT",
  "homepage": "https://github.com/chrisdevelops/hearthkit/tree/main/packages/auth",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisdevelops/hearthkit.git",
    "directory": "packages/auth"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./auth-contract": {
      "types": "./src/auth-contract-entry.ts",
      "default": "./src/auth-contract-entry.ts"
    }
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "24.20.0"
  },
  "scripts": {
    "prepublishOnly": "node ../../scripts/assert-package-publishable.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.2",
    "@hearthkit/config": "workspace:*",
    "@hearthkit/db": "workspace:*",
    "@hearthkit/email": "workspace:*",
    "better-auth": "1.7.2",
    "drizzle-orm": "0.45.2",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "next": "16.3.3",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
