{
  "name": "hearthkit",
  "private": true,
  "type": "module",
  "description": "Opinionated stack for shipping many small TypeScript web projects",
  "license": "MIT",
  "engines": {
    "node": "24.20.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "lint": "oxlint --type-aware .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --recursive --if-present run typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
